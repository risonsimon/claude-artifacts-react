# Copy to .env.local for `pnpm dev`. On Vercel or Cloudflare, set these in the project settings instead.

# Needed only if your artifact calls the Anthropic API (fetch to api.anthropic.com or window.claude.complete).
ANTHROPIC_API_KEY=

# Optional. Visitors must enter this password before the AI features work.
ARTIFACT_PASSWORD=

# Optional. Requests per visitor per minute (default 20, 0 turns the limit off).
RATE_LIMIT_PER_MINUTE=

# Optional. Use a different model or max_tokens than the artifact asks for.
ANTHROPIC_MODEL=
ANTHROPIC_MAX_TOKENS=
